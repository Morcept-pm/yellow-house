# Firebase Web SDK config (client-side, safe to expose in the browser bundle —
# access control is enforced by firestore.rules / storage.rules, not by hiding
# these values). Get these from: Firebase Console > Project Settings > General
# > Your apps > Web app > SDK setup and configuration > Config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- The following are used ONLY by local scripts (scripts/seed.ts,
# scripts/create-admin.ts) run with `npm run seed` / `npm run create-admin`.
# They are never bundled into the website and must NEVER be committed.
# Get them from: Firebase Console > Project Settings > Service Accounts >
# Generate new private key (downloads a JSON file — copy the three values
# below out of it, or point FIREBASE_ADMIN_CREDENTIALS_FILE at the file).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the private_key value including literal \n line breaks, wrapped in
# double quotes, e.g. "-----BEGIN PRIVATE KEY-----\nMII...\n-----END...-----\n"
FIREBASE_ADMIN_PRIVATE_KEY=

# First admin account created by `npm run create-admin`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=
